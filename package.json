{
  "name": "harmony-auxiliary-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @harmony/web dev",
    "build": "pnpm --filter @harmony/web build && pnpm --filter @harmony/api typecheck",
    "preview": "pnpm --filter @harmony/web preview",
    "test": "pnpm --filter @harmony/web test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:contracts": "pnpm --filter @harmony/contracts test"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
