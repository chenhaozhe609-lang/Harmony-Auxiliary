# Supabase configuration (optional).
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Project Settings -> API -> Project URL and Project API keys (anon / public).
#
# When these are absent, the app runs in "not configured" mode: authentication
# and cloud project management are disabled, and core creation still works.
# Only the public anon key belongs here. Never put the service_role key in the
# frontend or commit it to the repo.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
